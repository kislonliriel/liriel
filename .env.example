# Copy this file to .env and fill in your own values. Not needed at all to run Liriel with Claude Code
# (python liriel.py, see CLAUDE.md): only for Telegram, voice, or the other backends below. Never commit .env.

# ---------------------------------------------------------------------------
# Backend switch — this fork defaults to "litellm" (routes through
# llm_client.py/litellm to Groq, see below) for the instruction-following
# headroom a small local model didn't reliably have. "llamacpp" keeps every
# inference on a self-hosted llama-server instead (see scripts/llamacpp/) —
# no closed external API sees Liriel's state, the original project's
# decision (MS §17.6) — switch back to it any time by changing this one line.
# ---------------------------------------------------------------------------
# One-number switch (optional): 1 = run Liriel on a LOCAL llama-server (it must
# be running at LLAMACPP_BASE_URL), 2 = run on an API through litellm (as
# configured below, with your own key), 3 = a Claude Code session answers each
# call (what liriel.py and the Telegram bot with a Claude session use). When
# set, it wins over LLM_BACKEND.
# LLM_PROFILE=2
LLM_BACKEND=litellm
LLAMACPP_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# LLM — abstracted via litellm. Only read when LLM_BACKEND=litellm above.
# Swap providers by changing these two lines, nothing else in the code
# needs to change.
# ---------------------------------------------------------------------------

# Groq (this fork's default) — fast LPU-hosted inference over open-weight
# models. Get a key at https://console.groq.com/keys. Model catalog:
# https://console.groq.com/docs/models (check it occasionally — Groq
# retires/renames models faster than most providers).
LLM_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=
# (leave LLM_API_BASE empty — litellm routes groq/... on its own)

# --- Examples for switching to a different provider instead of Groq ---
# Local Ollama:
#   LLM_MODEL=ollama/gemma4:26b-a4b-it-qat
#   LLM_API_BASE=http://localhost:11434
# OpenAI:
#   LLM_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=sk-...
#   (leave LLM_API_BASE empty)
# Anthropic:
#   LLM_MODEL=claude-sonnet-5
#   ANTHROPIC_API_KEY=sk-ant-...
#   (leave LLM_API_BASE empty)

# Cost lever: the cycle's 3 structured-JSON calls (GRAPH_REQUEST,
# MOV_MAINMEMORY_UPDATE, BEST_PREY_GUESS) can run on a cheaper model than
# the 4th call (reply composition — the one call whose output quality you
# actually hear/read). Defaults to LLM_MODEL itself (no change) when unset.
# Same account/key as LLM_MODEL if both are Anthropic models — no new
# provider, no new credential. Example: keep LLM_MODEL=claude-sonnet-5 for
# the voice, route the other 3 to a cheaper Haiku:
#   LLM_MODEL_STRUCTURED=claude-haiku-4-5-20251001
LLM_MODEL_STRUCTURED=

LLM_TEMPERATURE_UPDATE=0.3
LLM_TEMPERATURE_DECISION=0.7
# Anthropic only (ignored elsewhere): current Claude models run extended
# thinking on by default, which measured ~87s and ~8.7k mostly-invisible
# reasoning tokens per call against the full MetaScheme-sized prompt.
# "low" measured 8-18s on the same prompts with no loss of schema validity
# or reasoning quality in testing. Raise to "medium"/"high" if you'd rather
# trade speed back for deeper reasoning on these two JSON-extraction
# queries. One of low/medium/high/xhigh/max.
LLM_EFFORT_UPDATE=low
LLM_EFFORT_DECISION=low
LLM_EFFORT_GRAPH=low
LLM_REQUEST_TIMEOUT=600

# How many times llm_client waits out a provider rate limit (it sleeps for the delay
# the provider names, e.g. Groq's "try again in 11.9s") before giving up. A cycle makes
# one call per Object in the MOV plus ~6 more, each carrying the whole MetaScheme.
LLM_RATE_LIMIT_RETRIES=8
# Max output tokens per call. No provider default is trustworthy enough to
# leave unset — a model whose reasoning tokens share the same budget as its
# visible completion can silently truncate mid-JSON well short of what
# looks like a generous limit (seen on claude-haiku-4-5 with the largest of
# the cycle's structured outputs, BEST_PREY_GUESS).
LLM_MAX_TOKENS=8192

# ---------------------------------------------------------------------------
# Graph of Traces (MS §8) — graph_service.py's TrackGraphProcess.
# ---------------------------------------------------------------------------
# Max archived (MainMemory) Objects one GRAPH_REQUEST item may pull into the
# graph, ranked by (1) emotional charge — sum of |v| across its Feeling
# axes, MS §7's own "organized by affective weight" — then (2) recency.
# Nothing in the MetaScheme caps this; it's a Phase 1 safety net so a broad
# multi-hop request can't inflate every remaining prompt of the cycle.
GRAPH_MAX_NODES=12
# Applies only when the model sets deep_recall_requested on a request
# (Phase 1 addition — the user explicitly insisted Liriel try hard to
# remember something specific). Nothing persists afterward: the next
# cycle's request just doesn't set the flag, and GRAPH_MAX_NODES applies
# again on its own.
GRAPH_MAX_NODES_BOOSTED=40
# Weight of the recency factor (0-1 per Object, see graph_service.py)
# relative to raw emotional charge when ranking archived candidates.
# Charge dominates by design; this only lets recency break close calls.
GRAPH_RECENCY_WEIGHT=2.0

# ---------------------------------------------------------------------------
# Nested MOVs (MS §6.8) — specular recursion ("what Fábio thinks of Mike",
# as distinct from Liriel's own read of Mike).
# ---------------------------------------------------------------------------
# How many mirror levels deep motivation.py gathers materialized nested
# MOVs into the prompt. MS §6.8 rule (d): "human adults sustain four or
# five orders before performance breaks down... do not nest deeper than
# the QUERY authorizes" — this is that authorization. A deeper one can
# still be created; it just won't be shown back to the model.
NESTED_MOV_MAX_DEPTH=2

# ---------------------------------------------------------------------------
# AIRP — cluster backbone recall + multi-cluster focus (MS §6.10, §7.4)
# ---------------------------------------------------------------------------
# How far a cluster recall reaches once its ScenarioData backbone has been
# found: 0 = just the matched principal object, 1 = the whole backbone,
# 2 = backbone + one hop from the principal, 3 = backbone + one hop from
# every backbone object, 4+ = one more hop from every backbone object per
# step up. See MS §7.4 for the exact rule at each value.
TRACE_DEPTH=1
# How many clusters may hold the focus at once before the oldest is filed
# to MainMemory to make room for a forming one. An Object or cluster still
# necessary to understand a matter currently in focus is never filed on
# this account alone (MS §7.4).
MEMORY_STRENGTH=2
# How many rounds one cycle's own MOV_MAINMEMORY_UPDATE query may run
# before it must settle for whatever it has retrieved (MS §7.6) — distinct
# from MEMORY_STRENGTH, which governs clusters in focus across cycles, not
# retrieval rounds within one cycle. 1 = no extra rounds (today's behavior).
MAX_RETRIEVAL_SUBQUERIES=3

# Per-item calls: one per hunter (HUNTER_READING, KQ07-09, MS §12.3A) and one per Object
# in the MOV and in each nested MOV (ANCHOR_REVIEW, KQ10-13, MS §12.3B). They are
# independent, so they may run in parallel — this is how many at once. 1 = sequential
# (safe against provider rate limits; every call carries the whole MetaScheme).
FANOUT_CONCURRENCY=1

# ---------------------------------------------------------------------------
# Telegram front end (telegram_bot.py) — optional, for YOUR OWN chat only,
# instead of (or alongside) the terminal. Anthropic's official Claude Code
# "channels" feature (https://code.claude.com/docs/en/channels) is the
# alternative way to reach your own session from a chat app.
# ---------------------------------------------------------------------------
# From @BotFather in Telegram: message it /newbot, choose a name and a
# username ending in "bot", then paste the token it gives you here.
TELEGRAM_BOT_TOKEN=
# REQUIRED: the bot refuses to start without it and never answers a chat
# that is not listed, so a stranger who finds its username can't drive
# Liriel's MOV. To learn your chat_id, run `python telegram_bot.py --whoami`
# and message your bot once (that mode prints the id on the console and
# never replies). Comma-separated for more than one (e.g. "111111111,222222222")
# — they all share the same MOV/conversation, there is no per-user split.
# Never commit this file: it holds your token and your chat id.
TELEGRAM_ALLOWED_CHAT_ID=

# Voice notes on Telegram (send Liriel audio, get audio back) — needs its
# own OpenAI key even when LLM_MODEL above is a Claude model, since
# Anthropic has no speech-to-text/text-to-speech endpoint. Get a key at
# https://platform.openai.com/api-keys and paste it here yourself.
OPENAI_API_KEY=
# Whisper model for transcribing an incoming voice note.
STT_MODEL=whisper-1
# OpenAI TTS model + voice for the spoken reply. Voice is one of
# alloy/echo/fable/onyx/nova/shimmer (tts-1/tts-1-hd/gpt-4o-mini-tts) plus
# ash/ballad/coral/sage/verse (gpt-4o-mini-tts only).
TTS_MODEL=tts-1
TTS_VOICE=nova
# Natural-language tone/character steering — only gpt-4o-mini-tts honors
# it (ignored elsewhere via litellm.drop_params). The 6 classic voice
# presets alone measured barely distinguishable from each other in
# Portuguese on tts-1 in this project's own testing; describing how to
# sound moved it far more than switching presets did. Leave blank to
# disable. Example that measured well:
#   TTS_INSTRUCTIONS=Voice: a young woman in her twenties — bright, light,
#   youthful timbre, not mature or deep. Tone: warm, cheerful, upbeat,
#   friendly, sweet — never flat or monotone.
TTS_INSTRUCTIONS=
# Emotion in the spoken reply. TTS_INSTRUCTIONS above says WHO the voice is and
# stays the same; with TTS_MODEL=gpt-4o-mini-tts (the only OpenAI TTS model that
# can be directed — there is no SSML and no emotion tag, only that free text)
# Liriel also writes, for every reply she speaks, a short direction of HOW it is
# said (emotion, pace, pauses, a laugh or a sigh), from her own Feelings and the
# words of the reply, and the reply itself carries the marks of speech she would
# really make ("...", "hm", "ah", "haha"). It costs one more short model call per
# spoken reply and is never made for tts-1/tts-1-hd. 0 turns it off.
TTS_DELIVERY=1

# ---------------------------------------------------------------------------
# Core identity — Phase 1 policy, not an MS §12 field.
# ---------------------------------------------------------------------------
# Who Liriel is (VOV_0000) and who made her (her creator, her developer)
# must never leave the focus via MS §7's normal archive cycle — losing one
# of these from the MOV isn't forgetting a case detail, it's losing who she
# is. Every ARCHIVE_VOV / ARCHIVE / ABANDON op naming one of these ids is
# refused (logged as a [notice], not applied). Everything else — including
# other reference-dataset Objects and anything created in live chat — still
# archives and retrieves via the Graph of Traces normally. Comma-separated;
# blank disables the guard entirely.
PROTECTED_VOV_IDS=VOV_0000,VOV_0001,VOV_0002

# Ollama only: context window in tokens. The official MetaScheme alone
# (docs/MetaScheme_Liriel_Rev0000.md) is ~18.7k tokens and is resident on
# every call; add the MOV and the query's JSON example and a typical call
# sits at 20-25k prompt tokens. Below Ollama's 4096-token default — or any
# value too small for the real prompt — the response comes back silently
# empty, with no error, which is easy to misdiagnose as a model or code
# bug. Keep this comfortably above your actual prompt size.
LLM_NUM_CTX=40960

# ---------------------------------------------------------------------------
# Database — PostgreSQL / Supabase.
#
# Preferred: discrete fields (PGHOST/PGUSER/PGPASSWORD/...). This avoids
# having to URL-encode special characters (@, :, /, ?, #, ...) in the
# password, which otherwise breaks a single DATABASE_URL string in a way
# that's easy to miss (host name gets silently corrupted).
#
# From Supabase: Project Settings > Database > Connect > Direct connection
# (or Session pooler, recommended if your network is IPv4-only) gives you
# host/port/user/dbname; the password is the one you set when creating the
# project (Supabase never shows it again — reset it there if you forgot it).
# ---------------------------------------------------------------------------
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=

# Alternative: a single connection string (only if you prefer it — remember
# to percent-encode any reserved character in the password, e.g. @ -> %40).
# If both are set, PGHOST/PGUSER/PGPASSWORD take priority.
DATABASE_URL=

# Leave both blank to use a local JSON fallback file for quick testing
# before Supabase is set up.

# ---------------------------------------------------------------------------
# Liriel
# ---------------------------------------------------------------------------
DEFAULT_MOV_ID=MOV_DEFAULT
LIRIEL_VERBOSE=false

# --- Selective retrieval limits (MetaScheme Rev 0006) ---
# Most bonds one Graph of Traces carries (normal / deep-recall), and how many
# Identity records one request returns (default / hard cap).
GRAPH_MAX_EDGES=60
GRAPH_MAX_EDGES_BOOSTED=150
IDENTITY_RECORDS_DEFAULT_LIMIT=5
IDENTITY_RECORDS_MAX=20

# --- Length of Liriel's text reply ---
# Most WORDS in her reply; 0 = no limit (default). To limit, e.g. REPLY_MAX_WORDS=150; to lift the
# limit, set it back to 0 or delete the line. Shortens the reply only — it saves seconds of a cycle
# that takes minutes (the time goes to the structured queries), so it is about brevity, not speed.
REPLY_MAX_WORDS=0

# Batch mode (MetaScheme Rev 0008, 12.12): hunters, reviewed Objects and changed targets asked in ONE call each instead of one call per
# item. Default: on only for LLM_PROFILE=3 (a Claude session answering the cycle). 1 forces it on, 0 off. A batch that comes back short
# or invalid falls back to asking that item alone.
LIRIEL_BATCH=
